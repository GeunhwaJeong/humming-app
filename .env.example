# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# Bluesky appview DID
EXPO_PUBLIC_BLUESKY_PROXY_DID=

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

# XRPC facade origin (the Humming home server in front of the Haneul chain).
# Baked into the bundle at build time; localhost is the localnet dev default.
EXPO_PUBLIC_HUMMING_SERVICE=

# Public web origin of the Humming app itself (share links, deep-link
# prefixes, internal-link detection). No trailing slash.
# Defaults to https://humming.social when empty.
EXPO_PUBLIC_HUMMING_APP_URL=

#
#
# Optional self-hosted services. All of these are EMPTY by default, which
# disables the corresponding feature/traffic entirely. Never point them at
# Bluesky infrastructure — Humming must not send user data to third parties.
#
#

# Metrics collector host. Empty = telemetry fully disabled.
EXPO_PUBLIC_METRICS_API_HOST=

# Growthbook config. Empty = feature gates evaluate to local defaults, no
# remote fetch.
EXPO_PUBLIC_GROWTHBOOK_API_HOST=
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# Link-card extraction proxy (cardyb-compatible, e.g.
# https://example.com/v1/extract?url=). Empty = composer shows bare links.
EXPO_PUBLIC_LINK_META_PROXY=

# geolocation service URL. Empty = unrestricted fallback config, no lookup.
EXPO_PUBLIC_GEOLOCATION_URL=
GEOLOCATION_DEV_URL=

# live-events web worker URL. Empty = no live-event feeds.
EXPO_PUBLIC_LIVE_EVENTS_URL=
LIVE_EVENTS_DEV_URL=

# app-config web worker URL. Empty = built-in default app config.
EXPO_PUBLIC_APP_CONFIG_URL=
APP_CONFIG_DEV_URL=

#
#
# Feature flags for surfaces whose backend Humming does not run (yet). All
# default to off; set to "true" only once a self-hosted replacement exists.
#
#

# Composer video attachment. Off = no uploads to a video service.
EXPO_PUBLIC_VIDEO_UPLOAD_ENABLED=

# Composer GIF picker. Off = no queries to a GIF search proxy.
EXPO_PUBLIC_GIF_PICKER_ENABLED=

# Direct messages UI. Off = Messages nav entries hidden, no chat calls.
EXPO_PUBLIC_CHAT_ENABLED=

# "Embed post" menu option. Off = no embed snippet generation.
EXPO_PUBLIC_EMBED_ENABLED=
